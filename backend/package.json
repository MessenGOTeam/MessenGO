{
  "name": "messengo-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MessenGO Node.js Microservices Monorepo - Sprint 1",
  "workspaces": [
    "shared",
    "services/*"
  ],
  "scripts": {
    "dev:auth": "cd services/auth-service && npm run dev",
    "dev:user": "cd services/user-service && npm run dev",
    "dev:chat": "cd services/chat-service && npm run dev",
    "dev:msg": "cd services/message-service && npm run dev",
    "test": "node tests/sprint1_auth_user.test.js",
    "test:sprint2": "node tests/sprint2_contact_chat.test.js",
    "test:sprint2:msg": "node tests/sprint2_message_ws.test.js"
  },
  "dependencies": {
    "ws": "^8.22.1"
  }
}
