# ==============================================================================
# MessenGO Environment Configuration
# ==============================================================================

# --- Infrastructure Exposed Ports ---
GATEWAY_PORT=80
MONGO_PORT=27017
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
COTURN_PORT=3478
COTURN_TLS_PORT=5349
COTURN_MIN_PORT=49152
COTURN_MAX_PORT=49200
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# --- Backend Microservices Internal Ports ---
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
CHAT_SERVICE_PORT=3003
MESSAGE_SERVICE_PORT=3004
MEDIA_SERVICE_PORT=3005
CALL_SERVICE_PORT=3006
UTILITY_SERVICE_PORT=3007
SEARCH_SERVICE_PORT=3008
NOTIFICATION_SERVICE_PORT=3009

# --- MongoDB Configuration ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=messengo_admin_pass
MONGO_HOST=mongodb
MONGO_URI=mongodb://admin:messengo_admin_pass@mongodb:27017

# --- Redis Configuration ---
REDIS_HOST=redis

# --- MinIO (S3 Object Storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_MEDIA_BUCKET=messengo-media
MINIO_BACKUP_BUCKET=messengo-backup
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# --- Coturn (STUN/TURN WebRTC Relay) ---
COTURN_USER=messengo
COTURN_SECRET=messengosecret
COTURN_REALM=messengo.local

# --- JWT Authentication ---
JWT_ACCESS_SECRET=messengo_access_jwt_super_secret_key_2026
JWT_REFRESH_SECRET=messengo_refresh_jwt_super_secret_key_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# --- SMS OTP Mock ---
OTP_EXPIRY_SECONDS=180
OTP_MOCK_ENABLED=true
